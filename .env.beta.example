# Copy these values into the production .env only after the normal required
# production settings in .env.example are present. This enables the beta
# product contract; user consent/readiness and daily caps still gate every send.
GRINDLY_AUTO_APPLY_MODE=live
GRINDLY_AUTOPILOT_ENABLED=1
GRINDLY_DIRECT_SUBMIT_ENABLED=1
GRINDLY_BROWSER_EXECUTOR_ENABLED=1
GRINDLY_SEARCH_DISCOVERY_ENABLED=1
GRINDLY_SEARCH_PROVIDER=searxng
SEARXNG_URL=http://searxng:8080
GRINDLY_ATS_APPLY=1
GRINDLY_DAILY_REPORT_ENABLED=1

# Enable only for the initial controlled Internshala cohort. Expand after
# observing successful runs and CAPTCHA rates in the admin health view.
INTERNSHALA_BETA_OPEN=1

# Tier B hosted submit — the worker submits on Internshala with the user's own
# connected session. This is the ONLY server-side path that touches a user
# account, so it has its own switch: GRINDLY_AUTO_APPLY_MODE=live alone never
# turns it on (see safety.tier_b_enabled). Without it, connected-Internshala
# users get matches banked and browser tasks queued, but nothing submits.
GRINDLY_TIER_B_APPLY=1

# Required for the user-facing daily report. Never commit real values.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=Grindly <noreply@your-domain.com>
