# Grindly config. Copy this file to `.env` and fill the REQUIRED block.
# `npm run setup` generates APP_ENCRYPTION_KEY for you if it's missing.
# Optional services degrade safely without keys; production paid upgrades require Razorpay.

# ============================ REQUIRED ============================

# Prisma CLI + Next both read this. Production uses Postgres (schema.prisma
# provider is "postgresql"). docker-compose provisions this exact server.
DATABASE_URL="postgresql://grindly:change_me_in_production@localhost:5432/grindly"

# AES-256-GCM key for encrypting platform session cookies at rest.
# MUST be 64 hex chars (32 bytes). Without it, connecting any platform throws.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# Python executable the web app spawns for the agent worker + connect flow.
# Use an absolute path if `python` isn't on PATH (e.g. a venv).
PYTHON_BIN=python

# ---- Google OAuth (login with Google) — required for Google sign-in ----
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback (dev)
#
# This client must request ONLY non-sensitive scopes (openid/email/profile).
# Keep it that way: a sensitive or restricted scope on this client forces the
# whole GCP project through Google verification, and login is the only way in.
# Its consent screen must be published ("In production"), not left in Testing —
# Testing serves only allowlisted test users and everyone else sees
# "Error 403: access_denied".
# Set the OAuth consent-screen app name to exactly "Grindly", verify it in a
# signed-out browser, then acknowledge that launch check here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_BRAND_VERIFIED=

# ============================ OPTIONAL ============================

# ---- Gmail interview tracker (restricted scope — needs Google verification) ----
# gmail.readonly is a RESTRICTED scope: the GCP project that registers it must
# pass Google verification (incl. a CASA security assessment) before serving the
# public. Put it in its OWN GCP project so it can't hold up login, and point
# these at that project's client. Unset = falls back to GOOGLE_CLIENT_ID/SECRET.
# Authorized redirect URI: https://<host>/api/auth/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Master switch. Leave unset/0 until gmail.readonly is verified — the dashboard
# hides the Connect Gmail button and /api/auth/gmail refuses, so no user is sent
# into a consent screen Google will block. Set to 1 after approval.
GMAIL_SCAN_ENABLED=
# Lets the agent SEND applications from the user's own Gmail (gmail.send) when a
# listing's real intake is an HR mailbox. Also restricted, also needs verification,
# and deliberately a SEPARATE switch from scanning: reading someone's inbox and
# sending mail as them are different grants with different consequences if either
# is wrong. Requested in the same consent screen when on. Set to 1 after approval.
GMAIL_SEND_ENABLED=

# ---- Auto-apply routing (agent/resolver.py + agent/safety.py) ----
# Most listings on the boards are cross-posts: the real application lives on the
# employer's own Google Form, HR mailbox or ATS page, where the candidate holds NO
# account — so submitting there carries no ban risk. The resolver finds that
# destination and grades it:
#   Tier A  employer's own intake, no account at stake  -> safe to send unattended
#   Tier B  a board the user gave us credentials to      -> needs GRINDLY_TIER_B_APPLY
#   Tier C  a board holding an account they can't lose   -> never sent server-side
#
# off    resolve nothing, behave as before routing existed
# shadow resolve and RECORD every destination, send nothing (default)
# live   Tier A destinations submit unattended
#
# Leave on shadow for at least a week after deploy, then read the coverage with
#   docker compose exec worker python agent/coverage_report.py --days 7
# That number — what share of real listings have an employer-side intake — is what
# should decide whether live is worth turning on. Anything unrecognised here reads
# as shadow, never live: a typo must not start sending mail in someone's name.
GRINDLY_AUTO_APPLY_MODE=shadow
# Tier B (hosted submit on a board the user handed credentials to) is a SEPARATE
# switch on top of live, so turning Tier A on can never silently turn on the one
# path that can cost a user their account. Set to 1 only deliberately.
GRINDLY_TIER_B_APPLY=
# Extra page loads one run may spend following "apply on the company website" links
# to find the real form. 0 disables link-following (JD-text resolution still works).
GRINDLY_RESOLVE_FETCH_BUDGET=12

# ---- Autopilot kill switches (agent/flags.py) ----
# Fleet-wide operational switches. Each holds work rather than losing it: a
# flagged-off executor's destinations are banked as matched and dispatch again
# when the flag returns. Per-user consent (the profile auto-apply toggle) is a
# separate layer that these can never override.
# Master: 0 = the agent discovers/scores/prepares but never sends anything
# by itself, regardless of every other setting below and above.
GRINDLY_AUTOPILOT_ENABLED=1
# Tier A server executors (Google Form / email / ATS) as one group.
GRINDLY_DIRECT_SUBMIT_ENABLED=1
# The user's-own-browser executor (extension autopilot). Dark until proven.
GRINDLY_BROWSER_EXECUTOR_ENABLED=0
# Web-search discovery adapter. Also needs SEARCH_API_KEY; dark by default.
GRINDLY_SEARCH_DISCOVERY_ENABLED=0
# End-of-run/daily user report delivery (report rows are written regardless).
GRINDLY_DAILY_REPORT_ENABLED=1
# Per-board discovery kill switches; unset means on. Example:
# GRINDLY_SOURCE_NAUKRI=0

# ---- Web discovery (agent/websearch.py + agent/websource.py) ----
# Searches the open web for internships on employers' OWN pages (careers page,
# Google Form, ATS posting). Those are the only listings the agent may submit
# unattended, because the candidate holds no account there — a board listing
# always needs their login. Turn on with:
#   GRINDLY_SEARCH_DISCOVERY_ENABLED=1
#
# Provider is swappable. Default `searxng` is the self-hosted instance in
# docker-compose.yml: no key, no per-query cost, no quota. At ~10-15 searches
# per user-run a hundred users is ~36k queries/month, past every hosted free
# tier — which is why the default is self-hosted rather than an API.
GRINDLY_SEARCH_PROVIDER=searxng
# Internal address of the compose service; no reason to change it.
SEARXNG_URL=http://searxng:8080
# Only for the hosted providers (serper | tavily). A self-hosted SearXNG needs
# no key; set this ONLY if you switch GRINDLY_SEARCH_PROVIDER away from searxng.
SEARCH_API_KEY=


# ---- Rate limiting ----
# Set to "1" when the app runs behind a trusted reverse proxy (Caddy, Nginx).
# Enables x-forwarded-for trust for IP-based rate limiting. Leave unset for local dev.
TRUST_PROXY=

# ---- Agent browser ----
# Run platform browsers headless (1) or visible (0). Connect flow needs 0 so the
# user can log in. Daily runs can use 1.
INTERNPILOT_HEADLESS=0
# Safety caps that sit under the plan cap (0 disables). Defaults are beta-safe.
GRINDLY_CAP_PER_PLATFORM=5
GRINDLY_CAP_PER_RUN=5
# Human pacing — set to "1" in production. Each apply waits 5-15 min before the next.
GRINDLY_SPREAD_APPLIES=
# Where per-user browser login sessions are stored. MUST be on a volume shared by
# the web app and every worker replica (the appdata volume in docker-compose).
GRINDLY_PROFILE_BASE=/app/data/browser_profile
# Seconds the login worker waits for the user to submit a one-time code (OTP relay).
GRINDLY_OTP_WAIT_SEC=180

# ---- Internshala credential-login rollout (staged) ----
# Auto-apply drives a real browser against Internshala — exposed to chosen accounts
# first while selectors/captcha are validated. Admins are always enabled.
# Comma/space-separated emails that get the credential form now:
INTERNSHALA_BETA_EMAILS=
# Set to 1 to open Internshala login to ALL users at once (after beta validation):
INTERNSHALA_BETA_OPEN=

# ---- Fusion LLM (5 providers, parallel ensemble — all free tier) ----
# Get keys from each provider below. Any subset works — more keys = better accuracy.
# 1. Google Gemini 2.0 Flash  → https://aistudio.google.com  (1M tokens/day free)
GEMINI_API_KEY=
# 2+5. Groq (Llama 3.3 70B + GPT-OSS 120B) → https://console.groq.com
GROQ_API_KEY=
# 3. Cerebras GLM 4.7         → https://cloud.cerebras.ai  (free tier)
CEREBRAS_API_KEY=
# 4. Mistral Small            → https://console.mistral.ai  (free tier)
MISTRAL_API_KEY=

# ---- Build ID (injected into service worker cache name — set in CI/CD) ----
# In Vercel this is auto-set. Locally it defaults to Date.now() so every restart busts cache.
# NEXT_PUBLIC_BUILD_ID=

# ---- Docker / Postgres (docker-compose only) ----
POSTGRES_PASSWORD=change_me_in_production
# Public domain of the deployed app — Caddy provisions HTTPS for it. Keep it in
# sync with NEXT_PUBLIC_APP_URL (host) and the Google OAuth redirect URI.
APP_DOMAIN=grindly.yourdomain.com

# ---- Admin email (must match the seeded admin account's email) ----
ADMIN_EMAIL=mahendharsammeta21@gmail.com

# ---- App URL (used in emails, OAuth redirects, TWA) ----
# Set to your production domain: https://grindly.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Android keystore (TWA / Play Store signing) ----
# Generate once: keytool -genkeypair -keystore android-keystore.jks -alias grindly -keyalg RSA -keysize 2048 -validity 10000 -storetype JKS
# Then: keytool -list -v -keystore android-keystore.jks -alias grindly → copy SHA256 to public/.well-known/assetlinks.json
ANDROID_KEYSTORE_PASS=

# ---- Payments — single explicit switch, independent of NODE_ENV/keys ----
# "true" is the ONLY value that turns on paid checkout. Unset/anything else
# keeps /api/pay + /api/pay/confirm returning 503 and the onboarding paid-plan
# button genuinely disabled (server-computed, surfaced via /api/me like
# gmailScanEnabled — not NEXT_PUBLIC_, since that would bake in at Docker
# build time rather than respond to this runtime env var) — not just labeled
# "coming soon" while still wired to a live checkout the moment Razorpay keys
# happen to exist in a non-strict-production environment (staging, key
# rotation, etc).
PAYMENTS_ENABLED=false

# ---- Razorpay (payment) — unset = free stub checkout, good for beta ----
# Get from: https://dashboard.razorpay.com → Settings → API Keys
# RAZORPAY_KEY_ID=rzp_test_...        # safe for frontend (used in checkout modal)
# RAZORPAY_KEY_SECRET=...             # server-only (signs orders + verifies payments)
# Webhook: Dashboard → Webhooks → Add → select payment.captured, payment.failed, refund.created
# RAZORPAY_WEBHOOK_SECRET=...

# ---- Slack (daily report delivery) — unset = console outbox ----
# SLACK_BOT_TOKEN=xoxb-...
# Ops alert channel (high apply-failure-rate warnings from the worker) — distinct
# from user-facing onboarding DMs. Defaults to "ops-alerts" if unset.
# OPS_SLACK_CHANNEL=#ops-alerts

# ---- Sentry (crash monitoring) — unset = errors only go to console/docker logs.
#      Same DSN works for both the web app and the Python worker (agent/worker.py).
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0

# ---- Legacy SMS OTP providers (not used by the current Google-only beta) ----
# Set ONE provider only if phone login is intentionally re-enabled.
# 1) Fast2SMS (India) — https://www.fast2sms.com → Dev API
# FAST2SMS_API_KEY=
# 2) MSG91 (India, scales) — https://msg91.com → needs a DLT-approved OTP template
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=
# MSG91_OTP_VAR=OTP        # variable name in your DLT template (default "OTP")
# 3) Twilio (international) — https://twilio.com
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+1...

# ---- Email SMTP — REQUIRED in production (unset = console/file outbox in dev,
#      silently dropped in prod → password reset broken). Free: Brevo (300/day) or
#      Resend (3k/mo). Paste the SMTP host/login they give you. See PHASE2_KEYS.md.
# EMAIL_SMTP_HOST=smtp-relay.brevo.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASS=
# EMAIL_FROM=Grindly <noreply@yourdomain.com>
