# NexPath config. Copy this file to `.env` and fill the REQUIRED block.
# `npm run setup` generates APP_ENCRYPTION_KEY for you if it's missing.
# Everything in OPTIONAL works without keys — pay + Slack + SMS run in stub mode.

# ============================ REQUIRED ============================

# Prisma CLI + Next both read this. Local default = sqlite file.
# Postgres: set provider=postgresql in schema.prisma and point this at the server.
DATABASE_URL="file:./dev.db"

# AES-256-GCM key for encrypting platform session cookies at rest.
# MUST be 64 hex chars (32 bytes). Without it, connecting any platform throws.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# Python executable the web app spawns for the agent worker + connect flow.
# Use an absolute path if `python` isn't on PATH (e.g. a venv).
PYTHON_BIN=python

# ============================ OPTIONAL ============================

# ---- Agent browser ----
# Run platform browsers headless (1) or visible (0). Connect flow needs 0 so the
# user can log in. Daily runs can use 1.
INTERNPILOT_HEADLESS=0
# Safety caps that sit under the plan cap (0 disables). Defaults are beta-safe.
NEXPATH_CAP_PER_PLATFORM=5
NEXPATH_CAP_PER_RUN=5

# ---- Local LLM (resume skill extraction; heuristic fallback if absent) ----
# INTERNPILOT_MODEL=qwen3:4b-instruct
# OLLAMA_HOST=http://127.0.0.1:11434

# ---- Stripe (payment) — unset = free stub checkout, good for beta ----
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Slack (daily report delivery) — unset = console outbox ----
# SLACK_BOT_TOKEN=xoxb-...

# ---- SMS OTP (Twilio) — unset = OTP printed to server log ----
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+1...

# ---- Email — unset = console outbox ----
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASS=
# EMAIL_FROM=NexPath <noreply@nexpath.app>
