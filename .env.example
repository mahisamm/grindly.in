# Grindly config. Copy to `.env` and fill the REQUIRED block.
# `npm run setup` generates APP_ENCRYPTION_KEY for you.
#
# Everything optional degrades safely: with none of it set, the product still
# reads resumes, scores them, and renders rebuilt PDFs. What you lose without an
# LLM key is the rewrite and the written review — not the measurement.

# ============================ REQUIRED ============================

# Prisma and Next both read this. PostgreSQL only — schema.prisma is Postgres.
# docker-compose provisions exactly this server.
DATABASE_URL="postgresql://grindly:change_me_in_production@localhost:5432/grindly"

# Signs session cookies. MUST be 64 hex characters (32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# The Python interpreter that has agent/requirements.txt installed. Every resume
# is read, scored and rendered by agent/cli.py, so this is not optional in
# practice — use an absolute path if `python` on PATH is the wrong one.
PYTHON_BIN=python

# ============================ RECOMMENDED =========================

# ---- LLM providers (any subset works; the first four have free tiers) ----
# Used ONLY for rewriting and for the written review. The readiness score is a
# pure function and never calls a model, so an outage here degrades the product
# rather than breaking it.
# 1. Groq          → https://console.groq.com
GROQ_API_KEY=
# 2. Google Gemini → https://aistudio.google.com
GEMINI_API_KEY=
# 3. Cerebras      → https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# 4. Mistral       → https://console.mistral.ai
MISTRAL_API_KEY=
# 5. OpenRouter    → https://openrouter.ai   (one key, many vendors)
#
# The most useful key on this list and the one to set first. It is an aggregator,
# so a model retirement at any single vendor does not take it down — which is the
# failure this project keeps hitting. Its free tier is 50 requests A DAY on an
# account with no credits, so agent/llm.py marks it `metered` and orders it after
# the uncapped providers; $10 of credit raises that to 1000/day.
OPENROUTER_API_KEY=
# 6. xAI / Grok    → https://console.x.ai    (no free tier — needs credits)
#
# Set XAI_MODEL from the account's own /v1/models list. The default in llm.py is
# a guess made without access to that list, and guessing model ids is how three
# providers were silently dead in production for a week.
XAI_API_KEY=
XAI_MODEL=

# Strips emails, phone numbers and long ID runs from every outbound prompt
# (agent/redact.py). On by default. Set to 0 only for a fully local model host.
GRINDLY_REDACT_PII=1

# ============================ OPTIONAL ============================

# ---- Google sign-in ----
# Email + password works without this. Add it to offer the Google button too.
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# Request ONLY non-sensitive scopes (openid/email/profile) — a restricted scope
# on this client puts your entire login flow behind Google verification.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- App URL (emails, OAuth redirects) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Admin ----
# This address is promoted to the admin role at signup. The very first account
# created on a fresh database also becomes an admin regardless.
ADMIN_EMAIL=

# ---- Payments ----
# "true" is the ONLY value that turns on real checkout, and BOTH keys must also
# be present. Anything else keeps the local stub, which grants passes without
# money moving so the whole flow stays testable. Inferring "go live" from a key
# being present is how a staging box takes real money.
PAYMENTS_ENABLED=false
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ---- Email (SMTP) ----
# Unset = mail is written to data/email-outbox.jsonl instead of being sent.
# Free tiers: Brevo (300/day), Resend (3k/month).
# EMAIL_SMTP_HOST=smtp-relay.brevo.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASS=
# EMAIL_FROM=Grindly <no-reply@yourdomain.com>

# ---- Error monitoring ----
# SENTRY_DSN=

# ---- Behind a reverse proxy ----
# Set to 1 ONLY when a proxy you control (Caddy, Nginx) sets x-forwarded-for.
# Without it that header is ignored entirely, because a client can forge it and
# a spoofable rate limit protects nothing.
TRUST_PROXY=

# ---- Rendering ----
# Milliseconds Chromium gets to lay out and print one resume.
# GRINDLY_RENDER_TIMEOUT_MS=20000

# ---- Docker / Postgres (docker-compose only) ----
POSTGRES_PASSWORD=change_me_in_production
# Public hostname; Caddy provisions HTTPS for it. Keep in sync with
# NEXT_PUBLIC_APP_URL and the Google OAuth redirect URI.
APP_DOMAIN=grindly.example.com
