# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.venv/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.pytest_tmp/
/.test-tmp/

# next.js
/.next/
/out/

# production
/build

# browser extension build artifacts
/extension/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.beta.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Android signing keystore — never commit this
android-keystore.jks
*.jks
*.p12

# Grindly runtime data (resumes, db, logs, slack outbox, browser session)
/data/
/prisma/dev.db
/prisma/dev.db-journal
/agent/browser_profile/
/agent/__pycache__/
*.pyc
.gstack/
devserver.log

# Local fleet overrides — never committed; they change apply behaviour per host.
docker-compose.override.yml
