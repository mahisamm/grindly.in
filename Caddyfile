# Auto-HTTPS (Let's Encrypt) for the public domain → reverse-proxy to the web
# container. APP_DOMAIN comes from the .env that docker-compose passes through.
{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
		# Any token riding in a query string is redacted before it is written.
		# Nothing in the current product puts one there, and the filter stays
		# because a log is written continuously and a mistake in it is only
		# discovered afterwards — by which point the value is on disk, in a
		# rotation, and possibly in a backup.
		format filter {
			request>uri query {
				replace token REDACTED
			}
		}
	}

	reverse_proxy web:3000
}
