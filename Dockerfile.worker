# Python agent worker — bundles Playwright + browsers for live apply.
FROM mcr.microsoft.com/playwright/python:v1.44.0-jammy
WORKDIR /app
COPY agent/requirements.txt ./agent/requirements.txt
# psycopg2-binary (in requirements) gives the Postgres driver agent/db.py uses.
# Re-run `playwright install` in case pip pulled a newer Playwright than the
# base image's bundled browsers.
RUN pip install --no-cache-dir -r agent/requirements.txt \
    && python -m playwright install chromium
# Xvfb: run Chromium headed inside a virtual framebuffer — eliminates the
# entire class of headless-mode JS probes (navigator.webdriver leaks, missing
# GPU renderer, zero outerWidth, etc.). Much harder to detect than headless.
RUN apt-get update && apt-get install -y --no-install-recommends xvfb procps \
    && rm -rf /var/lib/apt/lists/*

# Tectonic — the LaTeX engine used to recompile a user's own resume template
# after the agent edits its Skills/Hobbies sections (see agent/latex_resume.py).
#
# Chosen over a TeX Live install because it is a single ~50 MB binary rather than
# a 1 GB distro: it fetches only the packages a given document actually needs and
# caches them in TECTONIC_CACHE_DIR. That cache lives on the shared appdata volume,
# so the download happens once for the fleet, not once per container start — and a
# replica that restarts mid-month doesn't go back to the network.
#
# The first compile of a never-seen package set needs outbound HTTPS and takes
# ~30-60s; everything after is ~2s. compile_pdf() degrades to "send the master
# resume untouched" if this binary is missing, so the image still works without it.
ARG TECTONIC_VERSION=0.16.9
RUN curl -fsSL "https://github.com/tectonic-typesetting/tectonic/releases/download/tectonic%40${TECTONIC_VERSION}/tectonic-${TECTONIC_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
      | tar -xz -C /usr/local/bin tectonic \
    && chmod +x /usr/local/bin/tectonic \
    && tectonic --version

COPY agent ./agent
COPY prisma ./prisma
ENV PYTHONUNBUFFERED=1
ENV TECTONIC_CACHE_DIR=/app/data/tectonic-cache
# Same uid:gid as the web image's nextjs user — both containers share the
# appdata volume, so ownership must match or the worker can't write resumes.
RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 --gid 1001 worker \
    && mkdir -p /app/data/resumes /app/data/resume_tex /app/data/logs \
                /app/data/tectonic-cache \
    && chown -R worker:nodejs /app/data /app \
    && mkdir -p /home/worker \
    && chown -R worker:nodejs /home/worker \
    && chown -R worker:nodejs /ms-playwright 2>/dev/null || true
ENV HOME=/home/worker
USER worker
# Start Xvfb on :99, set DISPLAY, then run the worker (headed mode).
# INTERNPILOT_HEADLESS is intentionally NOT set here — default is "0" (headed).
#
# The stale-lock rm is load-bearing: `docker restart` keeps /tmp, and Xvfb
# refuses to start over a leftover /tmp/.X99-lock — the worker then runs with
# no display and every browser launch fails. Same reason we wait for the
# socket and exit 1 if it never appears: a restart loop in `docker ps` is
# diagnosable, a worker silently failing every apply is not.
# `exec` makes python PID 1: docker stop's SIGTERM used to hit the sh wrapper,
# which forwards nothing, so the worker was SIGKILLed mid-run and its queue
# lock sat for the full 30-minute stale window on every deploy. With exec the
# worker receives the SIGTERM itself and hands the run back (see
# run_queue.install_shutdown_handler). Xvfb stays alive across the exec — it
# is already running as a child by then.
CMD ["sh", "-c", "rm -f /tmp/.X99-lock /tmp/.X11-unix/X99; Xvfb :99 -screen 0 1366x768x24 -ac +extension GLX +render -noreset & i=0; until [ -S /tmp/.X11-unix/X99 ] || [ $i -ge 20 ]; do i=$((i+1)); sleep 0.5; done; if [ ! -S /tmp/.X11-unix/X99 ]; then echo 'FATAL: Xvfb never came up on :99' >&2; exit 1; fi; export DISPLAY=:99; exec python agent/worker.py --serve"]
