// Grindly — resume readiness and company tailoring.
//
// This schema replaced a 947-line one built for auto-applying to job boards.
// Roughly two thirds of it described state that only existed because the agent
// held accounts on other people's platforms: encrypted board credentials,
// browser task queues, per-application submission receipts, extension pairing
// tokens, thirty-odd screening answers collected so a bot could type them into
// someone else's form. None of that has a place in a product that hands the
// user a PDF and lets them apply themselves.
//
// The shape here is deliberately small. A user has resumes; a resume has a
// measured report and some variants; a variant may be aimed at a target. That
// is the whole product.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// closed vocabularies
// ---------------------------------------------------------------------------
//
// These were `String` columns with the legal values written in a comment beside
// them. A comment does not stop a typo, and the typo that matters here is not a
// crash: `plan = "Pass"` reads as an unknown plan, `limitsFor` falls through to
// the free tier, and a paying customer is quietly capped at two resumes with no
// error anywhere. Postgres refuses the write instead.
//
// Deliberately NOT enums: `Variant.label` (strategy names come from Python and
// change with the pipeline), `AuditLog.action` (an append-only log should never
// reject a new kind of event), `ErrorEvent.kind`.

/// What a user has bought. `admin` is not here on purpose — it is derived from
/// `role` at read time by lib/plans.ts and must never be a purchasable state.
enum Plan {
  free
  pack
  pass
}

enum Role {
  user
  admin
}

/// A support ticket's life: opened by the user, `answered` once the operator
/// has replied and the ball is with the user, `closed` by either side.
enum TicketStatus {
  open
  answered
  closed
}

/// Who wrote a support message. Not `Role`: the assistant is neither a user
/// nor an operator, and `lastMessageBy` needs to say "the bot spoke last".
enum MessageAuthor {
  user
  admin
  assistant
}

/// Who is carrying a conversation right now. Every conversation starts with
/// the assistant; it becomes `human` when the assistant hands over or an
/// operator replies, and stays human from then on.
enum HandledBy {
  assistant
  human
}

/// What the ticket is about. Set by the assistant from the conversation (or
/// `other` until it can tell); used for the admin filter, never shown as a
/// picker to the user.
enum TicketCategory {
  billing
  rebuild
  upload
  account
  bug
  feature
  other
}

enum OrderStatus {
  created
  paid
  failed
  refunded
}

/// The two things that can be bought. Mirrors PRODUCTS in lib/plans.ts.
enum Sku {
  pass90
  pack1
}

/// What a set of variants was aimed at. `notes` is the user's own hearsay about
/// an employer, kept apart from `company` precisely so the UI can label it as
/// theirs rather than as something we checked.
enum TargetKind {
  company
  jd
  notes
}

/// Where a rewrite batch got to.
///
/// `empty` is a success, not a failure: the rewrites ran and none of them beat
/// the user's own resume, which is a real and good answer. Conflating it with
/// `failed` would tell someone their resume is broken when what happened is
/// that it is already good.
enum RunStatus {
  running
  done
  empty
  failed
  cancelled
}

/// How profile addresses are printed in a rebuilt resume.
///
/// `url` prints the address AND makes it clickable. That is the default and it
/// is not a compromise: an extractor reads the text layer, so the anchor costs
/// it nothing, and a human gets a link they can follow.
///
/// `label` prints "LinkedIn" instead. It is tidier, it is what most resumes do,
/// and it is the exact practice this product exists to warn against — measured
/// on a real render, the address disappears from the text layer entirely, so an
/// application form asking for a profile URL gets nothing. Offered because it is
/// the user's document; the consequence is stated where they choose it.
enum LinkStyle {
  url
  label
}

/// Whether this account may use the product yet.
///
/// A closed beta needs a door, and the honest version of one is a state on the
/// account rather than a secret invite code: the person signs up, sees exactly
/// where they stand, and the operator sees a queue. `blocked` is separate from
/// deletion — an account that abused the free tier should stop working without
/// its owner's data being destroyed on the operator's say-so.
enum AccessStatus {
  pending
  approved
  blocked
}

/// Where an application got to. Set by the user, never inferred — Grindly does
/// not talk to any job board and will not pretend to know.
enum ApplicationStatus {
  sent
  screening
  interview
  offer
  rejected
  withdrawn
}

/// Why a score was recorded, for the history on a resume.
enum ScoreSource {
  upload
  rescore
  variant
  edit
}

// ---------------------------------------------------------------------------
// identity
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  // Argon2-style scrypt hash written by lib/password.ts. Null for accounts that
  // only ever signed in with Google — those must not fall back to a password
  // path, so the null is load-bearing rather than merely absent.
  passwordHash String? @map("password_hash")
  googleId     String? @unique @map("google_id")

  // free | pass. There is no monthly subscription on purpose: a placement season
  // is six to ten weeks, and a recurring charge for a product you need once is
  // how you earn a chargeback and a bad review from a satisfied customer.
  // A pass has an expiry; when it passes, the user drops to free and keeps
  // everything they already made.
  plan          Plan      @default(free)
  planExpiresAt DateTime? @map("plan_expires_at")

  role         Role   @default(user)

  /// Beta gate. Admins bypass it entirely — see lib/auth.requireApprovedUser —
  /// so an operator can never lock themselves out of their own queue.
  ///
  /// Defaults to `pending`, and the migration that added it set every EXISTING
  /// account to `approved`: a gate that retroactively locks out the people
  /// already using the product is not a gate, it is an outage.
  accessStatus AccessStatus @default(pending) @map("access_status")
  approvedAt   DateTime?    @map("approved_at")
  /// Who let them in. A user id rather than a relation: the reviewer is
  /// almost always the one admin, and a self-relation on User to record it
  /// would cost a join on every account read to answer a question nobody asks
  /// outside this one table.
  approvedBy   String?      @map("approved_by")
  // Session revocation counter, embedded in the signed cookie. Logout and any
  // credential change increment it, so an already-issued cookie stops working
  // immediately — a stateless HMAC cannot otherwise be revoked.
  tokenVersion Int    @default(0) @map("token_version")

  /// When this address was proven to belong to whoever holds the account.
  ///
  /// Null is the ordinary state for an account that has not clicked the link
  /// yet, and it does NOT gate signing in — a resume tool that locks people out
  /// of the product they just signed up for until they check their inbox loses
  /// more users than it protects. What it gates is anything that trusts the
  /// address to reach a person: a password reset to a typo'd address is an
  /// account nobody can recover.
  emailVerifiedAt DateTime? @map("email_verified_at")

  /// IANA zone, captured from the browser at sign-in. Daily quotas are counted
  /// in the user's own day — see lib/quota.ts — and before this column existed
  /// every account was counted in Asia/Kolkata regardless of where they were,
  /// while the refusal message told them the window resets at midnight in their
  /// timezone. Null means we have not been told yet and the default applies.
  /// Which of their resumes is the one they are actually sending out.
  ///
  /// A POINTER, and deliberately nothing more. Promoting a rebuild moves this
  /// id; it never edits, replaces or deletes the document that held it before.
  /// The old resume stays exactly where it was, keeps its score, its targets,
  /// its rewrites and the applications logged against it, and can be made
  /// primary again by pressing one button — because the alternative, promoting
  /// by overwrite, means a person who preferred yesterday's version has no way
  /// back and every "+18 points" this product ever claimed for them is measured
  /// against a baseline that no longer exists.
  ///
  /// Not a relation. A relation here needs an onDelete rule, and both available
  /// rules are wrong: Cascade would delete the ACCOUNT when its primary resume
  /// is deleted, and SetNull adds a foreign key to every resume delete for a
  /// column that reads correctly as a dangling id. `primaryResume()` in
  /// lib/primary.ts resolves it and falls back to the newest resume, so a stale
  /// id degrades to the old behaviour instead of to an error.
  primaryResumeId String? @map("primary_resume_id")

  /// The one free company-specific rebuild is claimed atomically by run id.
  /// Keeping the owner id (instead of a boolean) lets a failed run release only
  /// its own claim without reopening the entitlement after a later success.
  freeCompanyRunId String? @map("free_company_run_id")

  timezone  String?
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  resumes      Resume[]
  targets      Target[]
  orders       Order[]
  auditLogs    AuditLog[]
  usage        DailyUsage[]
  resetTokens  PasswordResetToken[]
  emailTokens  EmailVerificationToken[]
  problems     ProblemReport[]
  tickets      Ticket[]

  @@index([plan])
  /// The admin queue reads pending accounts oldest-first on every load.
  @@index([accessStatus, createdAt])
  @@map("users")
}

/// A single-use password reset.
///
/// Only the HASH of the token is stored. A reset table holding usable tokens is
/// a table that hands out every account the moment it leaks, and a database
/// backup or a stray log line is enough — so the emailed value exists in
/// exactly one place, the user's inbox.
model PasswordResetToken {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Proof that someone can read mail at an address.
///
/// Same shape as PasswordResetToken and for the same reason — only the hash is
/// stored, so a leaked backup is not a set of keys — with one addition that
/// carries the whole design of the email-change flow.
///
/// `email` is the address being PROVEN, which for a change is the new one and
/// is deliberately not yet on the user row. Writing the new address first and
/// verifying afterwards means a typo, or an attacker with a borrowed session,
/// moves the account's identity to somewhere nobody can sign in from. The user
/// row changes only when the link is clicked, and until then the old address
/// still works.
model EmailVerificationToken {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash")
  email     String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

// ---------------------------------------------------------------------------
// the evidence ledger
// ---------------------------------------------------------------------------

/// A resume the user uploaded or built, plus everything measured from it.
///
/// `text` is the extracted text, not the file — it is what every downstream
/// step reads, and storing it means a re-score never needs the original bytes
/// back. The file itself lives on disk under data/resumes/<id>.<ext>; the row
/// holds only the name and the extension so a delete can find it.
model Resume {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label        String  @default("My resume")
  originalName String? @map("original_name")
  ext          String? // ".pdf" | ".docx" | ".txt" — null for built-from-scratch
  text         String  @default("")
  chars        Int     @default(0)
  /// Printed pages of the uploaded file — real for a PDF, estimated for
  /// DOCX/TXT. With `careerStage`, the only input to the one-page suggestion.
  pages        Int?
  /// student | fresher | early | experienced — read off the resume at upload
  /// (readiness.career_stage), with the signals that led there.
  careerStage   String? @map("career_stage")
  careerSignals Json?   @map("career_signals")
  /// The user's answer to "want a one-page version?": 1 = yes (every rebuild
  /// carries a one-page budget), 0 = keep my length (never ask again),
  /// null = not asked / not answered.
  targetPages  Int?    @map("target_pages")
  /// True when the extracted text hit the 60 000-character ceiling and the tail
  /// was dropped. Everything downstream — the score, the rewrite, the fidelity
  /// count — then describes a fragment of the document, and the report says so
  /// rather than presenting a partial reading as a complete one.
  truncated    Boolean @default(false)

  /// JSON. Name, email, phone, GPA, marks — read off the header locally, never
  /// from a model, because the LLM boundary redacts PII on the way out and a
  /// model asked for the phone number faithfully returns "[phone redacted]".
  contactJson Json?   @map("contact_json")
  /// JSON array of URLs found in the PDF's link annotations. A resume that
  /// shows the word "LinkedIn" behind a hyperlink has an address no text
  /// extractor will ever see, and four real application forms asked for it.
  linksJson   Json?   @map("links_json")
  /// JSON array of the candidate's own skills. This is the allow-list every
  /// rewrite is checked against, so it is a claim of theirs, never ours.
  skillsJson  Json    @default("[]") @map("skills_json")

  /// Last untargeted readiness score. Denormalised out of reportJson so the
  /// list page can sort and show it without parsing a blob per row.
  score      Int?
  grade      String?
  /// JSON: the full readiness report — bands, findings, facts.
  reportJson Json?   @map("report_json")
  /// JSON: prose advice from the model. Separate column because it is optional,
  /// costs an LLM call, and must never be confused with the score.
  adviceJson Json?   @map("advice_json")

  /// The resume as editable fields: {name, contact_line, sections[{heading,
  /// items[{head, sub, bullets[]}]}]} — the exact shape render_pdf prints.
  ///
  /// Extracted by the same code every rewrite already ran, cached here because
  /// it costs model calls and the editor would otherwise pay for it on every
  /// page load. It is also what turns the product from one that tells you what
  /// is missing into one you can fix it in: the report says a bullet has no
  /// outcome, and this is the field you type the outcome into.
  ///
  /// Null means nobody has opened the editor for this resume yet.
  structJson Json? @map("struct_json")

  /// How this resume prints its profile addresses. See the LinkStyle enum.
  linkStyle LinkStyle @default(url) @map("link_style")

  /// Where this document came from, when it was not uploaded.
  ///
  /// Plain ids rather than relations, and that is the point: a promoted resume
  /// has to outlive the variant it came from — variants are superseded and
  /// deleted every time the same target is rebuilt — and outlive the resume it
  /// was rebuilt from, which the user may well delete once they have stopped
  /// sending it. A foreign key with either onDelete rule would take the
  /// promoted document down with its history or leave the same dangling id
  /// this column already tolerates. Both are null for an uploaded resume.
  fromVariantId  String? @map("from_variant_id")
  parentResumeId String? @map("parent_resume_id")

  /// The company this document was rebuilt for, copied at promotion time.
  ///
  /// Denormalised for the same reason `VariantRun.targetName` is: the row it
  /// came from does not last. A rebuild is superseded — row and file deleted —
  /// the moment the same target is run again, so resolving the employer through
  /// `fromVariantId` works until the user presses the button a second time and
  /// then quietly stops. It is the first word of the downloaded filename, and a
  /// filename that silently loses the company is worse than one that never had
  /// it, because nobody notices.
  ///
  /// Empty for an uploaded resume, which may have several targets and belongs
  /// to none of them.
  targetName String @default("") @map("target_name")

  /// A random token that makes the readiness report readable without an
  /// account, at /r/<token>.
  ///
  /// The report — not the resume, not the PDFs, not the contact details. What a
  /// share link exposes is the measurement and the findings, which is the part
  /// worth showing a senior who offered to look over your CV, and the part that
  /// contains nothing an employer could use to identify you.
  ///
  /// Null is the default and revoking sets it back to null, so a link that has
  /// been shared with the wrong person stops working rather than being merely
  /// hard to guess.
  shareToken String? @unique @map("share_token")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  variants     Variant[]
  targets      Target[]
  scores       ScoreEvent[]
  runs         VariantRun[]
  applications Application[]

  @@index([userId, createdAt])
  @@map("resumes")
}

/// Every score this resume has ever been given, in order.
///
/// `Resume.score` is the latest one and nothing else — it is overwritten on
/// every re-read, so the question a user most wants answered ("did the thing I
/// changed help?") had no data behind it at all. The product measures a document
/// on a fixed ruler; a ruler with no history can tell you where you are and
/// never that you are moving.
///
/// Append-only. Nothing updates a row here, and a delete only happens with the
/// resume it belongs to.
model ScoreEvent {
  id       String @id @default(cuid())
  resumeId String @map("resume_id")
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  score  Int
  grade  String
  source ScoreSource

  /// The variant this score came from, when it came from one. Deliberately not
  /// a relation: a variant is superseded and deleted on every re-run, and the
  /// history of what was measured must outlive the document that was measured.
  variantLabel String? @map("variant_label")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([resumeId, createdAt])
  @@map("score_events")
}

/// One rewrite batch, from the button press to the documents.
///
/// A batch is several model calls plus up to four headless Chromium renders —
/// minutes, not seconds. It used to run inside the POST that started it, which
/// meant the browser held a request open for the whole thing and the work
/// existed nowhere else. Close the tab, lose the connection, or let a phone
/// sleep, and the server finished the job and wrote the rows while the person
/// who asked for it saw nothing and had no way to find out.
///
/// The row is the fix. The POST creates it and returns immediately; the work
/// runs after the response and reports its progress here; the page polls it and
/// finds it again on a cold load. What the user waited for is now a thing that
/// exists rather than a connection that has to be held.
model VariantRun {
  id     String @id @default(cuid())
  userId String @map("user_id")

  resumeId String @map("resume_id")
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  /// Null for the untargeted "just make this better" run. Not a relation: a
  /// target can be deleted while a run that referenced it is still worth
  /// reading, and a failed run's history should not vanish with it.
  targetId   String? @map("target_id")
  targetName String  @default("") @map("target_name")

  status RunStatus @default(running)
  /// What it is doing right now, in the user's words rather than the
  /// pipeline's — "Rendering the second rebuild", not "[optimize] variant 2/3".
  stage  String    @default("Starting")
  /// Why it stopped, when it stopped badly. Shown to the user, so it is a
  /// sentence rather than a stack.
  error  String?

  /// How many rewrites were kept. Zero with status `empty` is the honest
  /// "nothing beat your resume" outcome.
  variantsMade Int @default(0) @map("variants_made")

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@index([resumeId, startedAt])
  @@index([status])
  @@map("variant_runs")
}

/// What a set of variants was aimed at: a curated company pack, or a pasted
/// job description. Null target means the untargeted "make this better" run.
model Target {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  resumeId String @map("resume_id")
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  kind TargetKind
  /// companies.py slug, for kind=company.
  slug String?
  /// Display name — the company, or the title parsed out of the JD.
  name String  @default("")

  /// The pasted job description, for kind=jd. Kept because the user will want
  /// to see what a variant was built against a week later, and because
  /// re-parsing it is free while re-asking them for it is not.
  jdText   String? @map("jd_text")
  /// JSON: parsed requirements — must_have, nice_to_have, skills.
  specJson Json?   @map("spec_json")

  /// Set when the ₹99 per-company purchase for THIS target settles (or when a
  /// stub deployment grants it). Null means tailored runs against this target
  /// are refused for non-pass accounts — creating the target and reading its
  /// gap report stay free, because that is the taste that sells the unlock.
  /// A Season Pass ignores this column entirely.
  unlockedAt DateTime? @map("unlocked_at")

  createdAt DateTime @default(now()) @map("created_at")

  variants Variant[]

  @@index([resumeId, createdAt])
  @@map("targets")
}

/// One measured rewrite. A variant only exists if it scored at least as high as
/// the master — `resume_optimize` drops the rest before they reach here, so
/// there is no "worse" state to filter out at read time.
model Variant {
  id       String @id @default(cuid())
  resumeId String @map("resume_id")
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  targetId String? @map("target_id")
  target   Target? @relation(fields: [targetId], references: [id], onDelete: Cascade)

  label         String // Keyword-optimized | Impact-focused | ATS-clean | Detail-first
  score         Int
  grade         String
  baselineScore Int     @map("baseline_score")
  beatsBaseline Boolean @default(false) @map("beats_baseline")
  pages         Int?

  /// JSON array of plain-English changes, shown to the user instead of a diff.
  changesJson  Json?   @map("changes_json")
  /// JSON: the full readiness report for THIS variant.
  reportJson   Json?   @map("report_json")
  /// JSON: {total, recovered, lost[], pct} — how much of what we printed
  /// survived being read back out of the PDF. The headline claim.
  fidelityJson Json?   @map("fidelity_json")

  /// The fields this rebuild was printed from — the same shape as
  /// Resume.structJson — and the text a parser read back off the finished PDF.
  ///
  /// Stored at build time rather than recovered on demand, because neither can
  /// be recovered faithfully afterwards. The struct cannot be re-derived from
  /// the PDF without a second extraction pass that costs model calls and
  /// returns strictly less than what we already held. The text could be
  /// re-extracted, but `score` was computed from THIS reading, and a promoted
  /// resume that re-extracts gets a number that disagrees with the one on the
  /// card it was promoted from.
  ///
  /// Null on rows written before promotion existed. Those variants can still be
  /// downloaded and compared; they simply cannot be promoted, and the button
  /// says so rather than failing when pressed.
  structJson Json?  @map("struct_json")
  text       String @default("")

  /// Filename under data/variants/<resumeId>/. Not the bytes: a three-variant
  /// batch is ~300 KB and the web app already shares this filesystem.
  file  String
  bytes Int    @default(0)

  /// A newer rebuild for the same purpose replaced this one in the workspace.
  /// The PDF and its measured score remain in the account library.
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([resumeId, createdAt])
  @@index([resumeId, archivedAt, createdAt])
  @@index([targetId])
  @@map("variants")
}

/// Where you sent this resume, and what happened.
///
/// Grindly does not submit anything and does not read anyone's inbox: bulk
/// submission through job boards breaks their terms and gets user accounts
/// banned, and that decision is the reason this product exists in its current
/// shape. So every row here is typed by the person who sent the application.
///
/// It earns its place by answering the one question a spreadsheet is usually
/// keeping: which VERSION of my resume did I send them? That is a join this
/// database can make and a spreadsheet cannot, and it is the difference between
/// "I applied to 40 places" and "the tailored version got three replies out of
/// nine and the generic one got none out of thirty-one".
model Application {
  id     String @id @default(cuid())
  userId String @map("user_id")

  resumeId String @map("resume_id")
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  /// Which document went out. Deliberately not a relation: a variant is
  /// superseded and deleted on the next rebuild, and the record of what you
  /// sent must outlive the file. The label is what a person recognises anyway.
  variantLabel String? @map("variant_label")

  company String
  role    String            @default("")
  status  ApplicationStatus @default(sent)
  notes   String?

  appliedAt DateTime  @default(now()) @map("applied_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userId, appliedAt])
  @@index([resumeId])
  @@map("applications")
}

// ---------------------------------------------------------------------------
// billing
// ---------------------------------------------------------------------------

/// A pass purchase. Razorpay when keys are set, a stub otherwise — the stub is
/// the default so the whole product is usable locally with no account anywhere.
model Order {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// pass90 | pack1 — see lib/plans.ts. The product bought is recorded on the
  /// order at creation, not read from the client at confirmation time.
  sku      Sku
  amount   Int // in the smallest unit (paise / cents)
  currency String      @default("INR")
  status   OrderStatus @default(created)

  /// For sku=pack1 (a per-company unlock): WHICH target this order pays for,
  /// validated against the buyer at checkout. Null for plan purchases. A plain
  /// column rather than a relation: the unlock must survive the target being
  /// deleted, because the order is the financial record.
  targetId String? @map("target_id")

  providerOrderId String? @unique @map("provider_order_id")
  /// Unique, so one captured payment can only ever settle one order. Without
  /// the constraint a replayed (order, payment, signature) triple could be
  /// spent against a second, more expensive order — the signature check alone
  /// does not stop that, because the HMAC is still valid.
  providerPaymentId String? @unique @map("provider_payment_id")

  createdAt DateTime  @default(now()) @map("created_at")
  paidAt    DateTime? @map("paid_at")

  @@index([userId, createdAt])
  /// The admin page sums every paid order on load. Without this that is a
  /// sequential scan of the table, growing with revenue.
  @@index([status])
  @@map("orders")
}

/// Something a user says went wrong.
///
/// Deliberately separate from ErrorEvent, which records faults the software
/// noticed. This records faults it did NOT notice — the ones where nothing threw
/// and the product simply did the wrong thing, which in a product built on
/// measurement is the more dangerous kind. A rewrite that quietly drops a job is
/// not an exception anywhere; it is a sentence a person has to type.
///
/// The account is recorded but nullable, so a report survives the reporter
/// deleting their account: the bug does not stop existing because they left.
model ProblemReport {
  id     String  @id @default(cuid())
  userId String? @map("user_id")
  /// Cascade, not SetNull.
  ///
  /// SetNull was the first version and it was wrong. Deleting an account here
  /// is a HARD delete — api/account/route.ts says so in its docstring and
  /// relies on every table hanging off User with onDelete: Cascade — and a
  /// detached report is not a deleted one. The message is free text somebody
  /// typed, and people describing a problem write "my resume at
  /// priya@example.com came back blank". Keeping that after they asked for
  /// everything to be removed keeps the sentence and drops only the label
  /// saying whose it was.
  ///
  /// The cost is real: a report from an account that then left is often the
  /// most informative one there is. It is still not ours to keep.
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// What they typed. The whole value of this table.
  message String
  /// Where they were when they hit it — captured by the widget rather than
  /// asked for, because "what page were you on" is a question people answer
  /// wrongly and resent being asked.
  path      String?
  userAgent String? @map("user_agent")
  /// The resume in view, when there was one. Turns "the rewrite was wrong" into
  /// a report someone can actually open.
  resumeId  String? @map("resume_id")

  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  /// positive | negative. Set once, by cmd_classify_feedback reading `message` —
  /// never by the reporter, who only ever typed the message itself. Null means
  /// "not classified yet", not "neutral"; there is no neutral bucket because the
  /// admin feedback view sorts into exactly two columns.
  sentiment String?
  /// One line, written by the same call that set `sentiment`. What the admin
  /// feedback view actually shows — the full `message` is one click away.
  summary String?
  classifiedAt DateTime? @map("classified_at")

  @@index([resolvedAt, createdAt])
  @@index([userId])
  @@index([sentiment])
  @@map("problem_reports")
}

// ---------------------------------------------------------------------------
// operations
// ---------------------------------------------------------------------------

/// A conversation between one user and the operator. The list the admin sees
/// is ordered by `lastMessageAt`; `lastMessageBy` says whose turn it is, and
/// the two `seenAt` stamps drive the unread badges on both sides.
model Ticket {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  category TicketCategory @default(other)
  subject  String
  status   TicketStatus @default(open)

  /// The assistant's running one-paragraph summary of the problem — what the
  /// operator reads instead of the whole thread.
  summary     String?
  handledBy   HandledBy @default(assistant) @map("handled_by")
  escalatedAt DateTime? @map("escalated_at")

  lastMessageAt DateTime      @default(now()) @map("last_message_at")
  lastMessageBy MessageAuthor @default(user) @map("last_message_by")
  userSeenAt    DateTime?     @map("user_seen_at")
  adminSeenAt   DateTime?     @map("admin_seen_at")

  createdAt DateTime  @default(now()) @map("created_at")
  closedAt  DateTime? @map("closed_at")

  messages TicketMessage[]

  @@index([status, lastMessageAt])
  @@index([handledBy, status])
  @@index([userId, createdAt])
  @@map("tickets")
}

model TicketMessage {
  id       String @id @default(cuid())
  ticketId String @map("ticket_id")
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// Who wrote it — the user, an operator, or the assistant. `authorId` is
  /// informational (which admin), never used for access decisions.
  authorRole MessageAuthor @map("author_role")
  authorId   String?       @map("author_id")
  body       String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

/// One row per page navigation, written by a client beacon (see
/// components/TrafficBeacon.tsx and api/track). `visitorId` is a random
/// first-party cookie value — not an IP, not a fingerprint — so "unique
/// visitors" is honest about what it counts: browsers that kept our cookie.
/// `path` is the pathname only, never the query string.
model PageView {
  id        String  @id @default(cuid())
  path      String
  visitorId String  @map("visitor_id")
  userId    String? @map("user_id")
  /// First-touch campaign labels only (never the full query string). Kept
  /// bounded and optional so an untagged visit remains anonymous traffic, not
  /// an invented "direct" campaign.
  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  /// Origin hostname only, not a full referring URL (which can contain a
  /// search query or another person's data).
  referrerHost String? @map("referrer_host")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([visitorId, createdAt])
  @@index([utmSource, createdAt])
  @@map("page_views")
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  action    String // signup | login | logout | resume_upload | variants | tailor | delete | pay
  target    String?
  detail    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  /// Both the retention sweep and every "what happened around 3pm" question
  /// filter on time. This is also the index the sweep's DELETE uses.
  @@index([createdAt])
  @@map("audit_logs")
}

model RateLimitEntry {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  windowEnd DateTime @map("window_end")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([key])
  /// The sweep in lib/rateLimit.ts deletes every row whose window has closed.
  /// Without this index that DELETE is a sequential scan of the whole table —
  /// on the one path that runs on every rate-limited request in the app.
  @@index([windowEnd])
  @@map("rate_limit_entries")
}

model ErrorEvent {
  id          String  @id @default(cuid())
  fingerprint String  @unique
  source      String // web | agent | browser — see lib/errors.ts
  kind        String
  message     String
  stack       String?
  context     String?
  count       Int     @default(1)

  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  resolvedAt  DateTime? @map("resolved_at")

  @@index([lastSeenAt])
  @@index([resolvedAt])
  @@map("error_events")
}

/// Per-user daily ceilings on the two operations that cost real compute: a
/// variant batch (several model calls plus a headless Chromium render) and an
/// advice call. Counted in the user's local day, because "5 a day" has to mean
/// their day or the window slides for everyone outside UTC.
model DailyUsage {
  id        String @id @default(cuid())
  userId    String @map("user_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  localDate String @map("local_date")

  variantRuns Int @default(0) @map("variant_runs")
  adviceRuns  Int @default(0) @map("advice_runs")
  uploads     Int @default(0)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, localDate])
  @@map("daily_usage")
}

/// Written by scripts/backup-drill.sh, never by the app — and declared here
/// anyway, because `prisma db push` manages the whole `public` schema and
/// treats anything it does not know about as something to drop.
///
/// It did. A deploy failed with "you are about to drop the `backup_health`
/// table, which is not empty", `migrate` exited 1, and `web` — which waits for
/// migrate to complete successfully — never started. Compose had already
/// stopped the old container by then, so the site returned 502 until someone
/// intervened. The guard was right to refuse; the table simply should not have
/// been invisible to it.
///
/// Nothing reads this through Prisma. It is here so Prisma leaves it alone.
model BackupHealth {
  id            String    @id @default("singleton")
  lastDumpAt    DateTime? @map("last_dump_at") @db.Timestamptz(6)
  lastRestoreAt DateTime? @map("last_restore_at") @db.Timestamptz(6)
  lastRestoreOk Boolean?  @default(false) @map("last_restore_ok")
  lastRowCount  Int?      @map("last_row_count")
  updatedAt     DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("backup_health")
}
