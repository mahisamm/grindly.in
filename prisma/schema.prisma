// Intern-Agent SaaS data model. Owned by Prisma; the Python agent reads/writes
// the same database (SQLite locally, Postgres in prod) via agent/db.py, which
// auto-detects the backend from DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Production backend. DATABASE_URL points at the Postgres server (see
  // docker-compose.yml / prisma/MIGRATE_POSTGRES.md). For a quick local SQLite
  // run, set provider = "sqlite" and DATABASE_URL="file:./dev.db".
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum value sets below are verified against the actual read/write call sites
// in src/ and agent/ (not just doc comments) — see src/lib/applyState.ts,
// which is the mirrored single source of truth for ApplyStatus/FailureReason
// shared with agent/safety.py.

enum Role {
  user
  admin
}

enum PlanTier {
  free
  starter
  pro
}

enum UserStatus {
  registered
  onboarding
  active
  paused
}

enum Platform {
  linkedin
  internshala
  naukri
  unstop
  indeed
  gmail
}

enum IntegrationStatus {
  connected
  disconnected
  needs_login
  connecting
}

enum ApplyStatus {
  matched
  approved
  submitting
  applied
  skipped
  failed
  needs_review
}

enum FailureReason {
  session_expired
  selector_missing
  captcha
  listing_closed
  upload_failed
  firewall_blocked
  custom_questions
  timeout
  exception
}

enum Outcome {
  interview
  offer
  rejected
  no_response
}

enum RunMode {
  mock
  live
  analyze
}

enum RunStatus {
  queued
  running
  done
  failed
  cancelled
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?  @map("password_hash")
  googleId      String?  @unique @map("google_id")
  phone         String?  @unique
  phoneVerified Boolean  @default(false) @map("phone_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  // billing (stubbed, real-ready)
  paid          Boolean  @default(false)
  plan          PlanTier @default(free)
  // slack (stubbed, real-ready)
  slackUserId   String?  @map("slack_user_id")
  slackChannel  String?  @map("slack_channel")
  slackConnected Boolean @default(false) @map("slack_connected")
  // internshala session (persistent browser profile) ready?
  internshalaConnected Boolean @default(false) @map("internshala_connected")
  // lifecycle: registered -> onboarding -> active -> paused
  status        UserStatus @default(registered)
  // access role: user (default) | admin. Admin-only dashboard gates on this
  // column server-side — never on email or a client flag.
  role          Role     @default(user)

  profile        Profile?
  applications   Application[]
  reports        Report[]
  integrations   UserIntegration[]
  resumeVersions ResumeVersion[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  agentRuns      AgentRun[]
  credentials    PlatformCredential[]

  @@map("users")
}

model UserIntegration {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    Platform
  status      IntegrationStatus @default(disconnected)
  connectedAt DateTime? @map("connected_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Remote-browser connect flow (hosted, headless server — see connect_service.py):
  // a short-lived, single-use, random token handed to the frontend so it can
  // open a view of the live login browser over the connect service's
  // websocket bridge. High-entropy + short expiry is the whole security
  // model here — never log this value, never expose it outside an
  // authenticated response to the owning user.
  connectToken          String?   @map("connect_token")
  connectTokenExpiresAt DateTime? @map("connect_token_expires_at")

  @@unique([userId, platform])
  @@map("user_integrations")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  resumeText String? @map("resume_text")
  resumeName String? @map("resume_name")
  skills     String  @default("[]") // JSON array of skills (agent-extracted)
  education  String?
  experienceLevel String? @map("experience_level") // student | fresher | 1-2yr
  phone      String? // for form fill (LinkedIn phone field)
  gpa        Float?  @default(8.0)  // GPA for form fill

  // proff (preference/profile) answers + firewall constraints
  preferredDomains   String @default("[]") @map("preferred_domains")   // JSON array
  preferredLocations String @default("[]") @map("preferred_locations") // JSON array
  workMode           String @default("any") @map("work_mode")          // remote | onsite | any
  stipendMin         Int    @default(0)     @map("stipend_min")
  maxPerDay          Int    @default(10)    @map("max_per_day")
  minMatchScore      Int    @default(65)    @map("min_match_score")     // 0-100 firewall threshold
  excludedCompanies  String @default("[]")  @map("excluded_companies")  // JSON array
  autoApply          Boolean @default(true) @map("auto_apply")

  resumeScore       Int?     @map("resume_score")       // 0-100 quality score
  resumeSuggestions String?  @map("resume_suggestions")  // JSON analysis from resume_ai

  // beta: one-tap "are these matches good?" survey (1-5). null = not yet asked
  matchQualityRating Int?     @map("match_quality_rating")
  // beta: surfaced to user when resume parsing produced no skills (manual fallback)
  resumeParseFailed  Boolean  @default(false) @map("resume_parse_failed")

  // explicit consent timestamp for auto-apply (audit trail; null = never consented)
  autoApplyConsentAt DateTime? @map("auto_apply_consent_at")

  planJson   String?  @map("plan_json")   // agent-generated plan
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model Job {
  id         String   @id @default(cuid())
  source     String   @default("internshala")
  externalId String   @map("external_id")
  title      String
  company    String
  location   String?
  stipend    String?
  duration   String?
  skills     String   @default("[]") // JSON array
  url        String
  scrapedAt  DateTime @default(now()) @map("scraped_at")

  applications Application[]

  @@unique([source, externalId])
  @@map("jobs")
}

model Application {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId      String?  @map("job_id")
  job        Job?     @relation(fields: [jobId], references: [id])

  jobTitle   String   @map("job_title")
  company    String
  url        String?
  matchScore Int      @default(0) @map("match_score")
  // lifecycle: matched | approved | submitting | applied | skipped | failed | needs_review
  status     ApplyStatus @default(matched)
  reason     String?  // why matched / why skipped / failure detail
  // enumerated machine reason on failure — see FailureReason
  failureReason  FailureReason? @map("failure_reason")
  screenshotPath String? @map("screenshot_path")  // proof image of the submit attempt
  // immutable snapshot of the exact resume sent for this application
  resumeVersionId String?        @map("resume_version_id")
  resumeVersion   ResumeVersion? @relation(fields: [resumeVersionId], references: [id])
  appliedAt  DateTime? @map("applied_at")
  // user-reported outcome — the single most important beta signal (interview rate)
  // null (unset) until the user reports one
  outcome    Outcome?  @map("outcome")
  outcomeAt  DateTime? @map("outcome_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, status])
  @@index([status])
  @@index([jobId])
  @@index([resumeVersionId])
  @@index([createdAt])
  @@map("applications")
}

// Immutable record of the exact resume version sent for an application.
// Answers "which resume did the recruiter see?" — never mutated after create.
model ResumeVersion {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String   // human label e.g. "Frontend Dev @ Razorpay"
  jobTitle      String?  @map("job_title")
  company       String?
  text          String   // exact tailored resume text sent
  filePath      String?  @map("file_path")      // path to the exact PDF sent
  skillsClaimed String   @default("[]") @map("skills_claimed") // JSON: skills surfaced for this role
  baseSkills    String   @default("[]") @map("base_skills")    // JSON: master skills at time (truthfulness ref)
  createdAt     DateTime @default(now()) @map("created_at")

  applications  Application[]

  @@index([userId])
  @@map("resume_versions")
}

// Append-only audit trail — reconstruct what the agent/auth did, for disputes.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // login | otp_issued | otp_throttled | apply | apply_failed | firewall_block | session_expired | consent
  target    String?  // job url / platform / phone-mask / etc
  detail    String?  // freeform or JSON
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

// DB-backed run queue — gives retries, per-user locking, and idempotent resume
// without needing Redis in the prototype. A worker (`worker.py --drain`) claims
// queued rows transactionally. Swap for BullMQ/Celery later behind the same shape.
model AgentRun {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode        RunMode   @default(mock)
  status      RunStatus @default(queued)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  lockedBy    String?   @map("locked_by") // worker id holding the row
  lockedAt    DateTime? @map("locked_at")
  error       String?
  result      String?   // JSON {applied,matched,failed}
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([userId])
  @@map("agent_runs")
}

// Encrypted-at-rest platform credentials. Plaintext NEVER stored — ciphertext is
// AES-256-GCM (see src/lib/crypto.ts / agent/secret_box.py). Prefer storing
// session cookies over passwords; both go here encrypted.
model PlatformCredential {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String
  ciphertext String   // base64(nonce).base64(ciphertext+tag)
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, platform])
  @@map("platform_credentials")
}

// Tiered notification log with delivery tracking + channel fallback.
model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier      String   @default("digest") // urgent | digest
  channel   String   // slack | email | console
  title     String
  body      String
  delivered Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("notifications")
}

model Report {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String   // YYYY-MM-DD
  matchedCount Int      @default(0) @map("matched_count")
  appliedCount Int      @default(0) @map("applied_count")
  failedCount  Int      @default(0) @map("failed_count")
  summary      String   @default("")
  delivered    Boolean  @default(false) // sent to slack?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("reports")
}

model OtpToken {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@map("otp_tokens")
}

// DB-backed OTP brute-force counter. Replaces in-process Map in otp.ts.
// Survives multi-instance / serverless restarts.
model OtpAttempt {
  id         String   @id @default(cuid())
  phone      String   @unique
  attempts   Int      @default(0)
  windowEnd  DateTime @map("window_end")
  lockedUntil DateTime? @map("locked_until")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([phone])
  @@map("otp_attempts")
}

// DB-backed password reset tokens. 15-minute TTL, single-use.
// Replaces the in-process Map in passwordReset.ts.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash") // SHA-256 of the raw token
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// DB-backed rate-limit counters. Replaces in-process Map in rateLimit.ts.
// key = "forgot:<ip>" | "otp:<phone>" | etc.
model RateLimitEntry {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  windowEnd DateTime @map("window_end")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@map("rate_limit_entries")
}
