// Intern-Agent SaaS data model. Owned by Prisma; the Python agent reads/writes
// the same database (SQLite locally, Postgres in prod) via agent/db.py, which
// auto-detects the backend from DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Production backend. DATABASE_URL points at the Postgres server (see
  // docker-compose.yml / prisma/MIGRATE_POSTGRES.md). For a quick local SQLite
  // run, set provider = "sqlite" and DATABASE_URL="file:./dev.db".
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum value sets below are verified against the actual read/write call sites
// in src/ and agent/ (not just doc comments) — see src/lib/applyState.ts,
// which is the mirrored single source of truth for ApplyStatus/FailureReason
// shared with agent/safety.py.

enum ApplyStatus {
  matched
  approved
  submitting
  applied
  skipped
  failed
  needs_review
}

enum FailureReason {
  session_expired
  selector_missing
  captcha
  listing_closed
  upload_failed
  firewall_blocked
  custom_questions
  timeout
  exception
}

enum Outcome {
  interview
  offer
  rejected
  no_response
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?  @map("password_hash")
  googleId      String?  @unique @map("google_id")
  phone         String?  @unique
  phoneVerified Boolean  @default(false) @map("phone_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  // billing (stubbed, real-ready)
  paid          Boolean  @default(false)
  // Loose strings, not Postgres enums (PlanTier/UserStatus/Role): the live
  // production `users` table already has plan/status/role as plain `text`
  // columns (confirmed via \d users) — these enums were declared in schema
  // but never actually applied to prod, so `prisma db push` was trying to
  // convert text -> enum, which Postgres can only do via drop-and-recreate
  // (data loss on every row). Matching what's actually live instead.
  // free | plus | pro.  "starter" is the legacy name for "plus" and may still be
  // present on old rows — every read goes through normalizePlan() (src/lib/plans.ts)
  // / _norm_plan() (agent/db.py) rather than comparing this string directly.
  plan          String   @default("free")
  // slack (stubbed, real-ready)
  slackUserId   String?  @map("slack_user_id")
  slackChannel  String?  @map("slack_channel")
  slackConnected Boolean @default(false) @map("slack_connected")
  // internshala session (persistent browser profile) ready?
  internshalaConnected Boolean @default(false) @map("internshala_connected")
  // Legacy flag, superseded by internshalaBetaAccess below — unused by any
  // current code path (verified via grep), but still live with real rows.
  // Declared here (not dropped) purely so `prisma db push` leaves it alone;
  // safe to actually drop later via a real migration once confirmed unused
  // in practice, not just in code.
  internshalaAccess Boolean @default(false) @map("internshala_access")
  // staged-rollout grant: admin can enable Internshala auto-apply for this user
  // even when the global beta isn't open. OR'd with email/role/INTERNSHALA_BETA_OPEN.
  internshalaBetaAccess Boolean @default(false) @map("internshala_beta_access")
  // lifecycle: registered -> onboarding -> active -> paused
  status        String   @default("registered")
  // access role: user (default) | admin. Admin-only dashboard gates on this
  // column server-side — never on email or a client flag.
  role          String   @default("user")
  // Session revocation counter. Embedded in the signed session cookie; getUid()
  // rejects any cookie whose version is below this. Incremented on logout (and
  // any future force-logout / credential change) so a leaked or already-issued
  // cookie stops working immediately — a stateless HMAC alone can't be revoked.
  tokenVersion  Int      @default(0) @map("token_version")

  // Access gating (approval-gated beta). A new account is "pending" and sees the
  // waitlist; only "approved" users reach the app and can run the agent. The
  // owner email and any pre-allowlisted email are auto-approved at signup. Values:
  // pending | approved | denied. Existing rows predate this column — because the
  // live DB was empty when it shipped, the @default backfills them as pending
  // with no one locked out; on a populated DB you would backfill approved first.
  accessStatus      String    @default("pending") @map("access_status")
  // When the user actively tapped "Request access" (vs just signing up and
  // bouncing) — lets the admin queue surface real intent first.
  accessRequestedAt DateTime? @map("access_requested_at")
  accessGrantedAt   DateTime? @map("access_granted_at")

  profile        Profile?
  applications   Application[]
  reports        Report[]
  integrations   UserIntegration[]
  resumeVersions ResumeVersion[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  agentRuns      AgentRun[]
  credentials    PlatformCredential[]

  @@map("users")
}

model UserIntegration {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    String    // linkedin | internshala | naukri | unstop | indeed
  // Loose string, not a Postgres enum: this session's captcha circuit
  // breaker added "challenge_detected" as a status value that was never
  // added to the old IntegrationStatus enum — would have thrown an invalid-
  // enum-value error the first time it ran against real Postgres (SQLite
  // tests never caught it, since SQLite doesn't enforce enum constraints).
  // connected | disconnected | connecting | needs_login | otp_required |
  // challenge_detected
  status      String    @default("disconnected")
  connectedAt DateTime? @map("connected_at")
  // Credential-login relay (hosted): the worker logs in headless on the server.
  // When the platform demands a one-time code, it flips otpRequired and waits for
  // the user to post the code into otpCode; lastError surfaces a failure to the UI.
  otpRequired Boolean   @default(false) @map("otp_required")
  otpCode     String?   @map("otp_code")
  lastError   String?   @map("last_error")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Remote-browser connect flow (hosted, headless server — see connect_service.py):
  // a short-lived, single-use, random token handed to the frontend so it can
  // open a view of the live login browser over the connect service's
  // websocket bridge. High-entropy + short expiry is the whole security
  // model here — never log this value, never expose it outside an
  // authenticated response to the owning user.
  connectToken          String?   @map("connect_token")
  connectTokenExpiresAt DateTime? @map("connect_token_expires_at")
  connectClaimedBy      String?   @map("connect_claimed_by")
  connectClaimedAt      DateTime? @map("connect_claimed_at")

  @@unique([userId, platform])
  @@map("user_integrations")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  resumeText String? @map("resume_text")
  resumeName String? @map("resume_name")
  // Optional LaTeX source of the master resume (data/resume_tex/<uid>.tex).
  // When present, per-job tailoring edits the .tex in place and recompiles, so
  // the output is byte-identical to the user's own template. When absent, the
  // agent sends the master PDF UNTOUCHED — it must never regenerate a resume
  // from plain text, which is what produced the "patched-looking" output.
  resumeTexName String? @map("resume_tex_name")
  // Result of compiling the UNEDITED .tex the moment it was uploaded:
  //   ok | no_sections | compile_failed | page_mismatch | no_compiler
  //
  // Without this, a .tex that can't be compiled — or whose section headings this
  // template doesn't recognise — fails silently and forever: compile_pdf() returns
  // False, the master resume goes out untouched, and the user is never told that
  // the feature they uploaded a file for is doing nothing. A guard that fails
  // silently is not a guard. Checked once at upload, not per-application.
  resumeTexStatus String? @map("resume_tex_status")
  resumeTexDetail String? @map("resume_tex_detail")
  skills     String  @default("[]") // JSON array of skills (agent-extracted)
  education  String?
  experienceLevel String? @map("experience_level") // student | fresher | 1-2yr
  phone      String? // for form fill (LinkedIn phone field)
  gpa        Float?  @default(8.0)  // GPA for form fill

  // proff (preference/profile) answers + firewall constraints
  preferredDomains   String @default("[]") @map("preferred_domains")   // JSON array
  preferredLocations String @default("[]") @map("preferred_locations") // JSON array
  workMode           String @default("any") @map("work_mode")          // remote | onsite | any
  stipendMin         Int    @default(0)     @map("stipend_min")
  maxPerDay          Int    @default(10)    @map("max_per_day")
  minMatchScore      Int    @default(65)    @map("min_match_score")     // 0-100 firewall threshold
  excludedCompanies  String @default("[]")  @map("excluded_companies")  // JSON array
  autoApply          Boolean @default(true) @map("auto_apply")

  resumeScore       Int?     @map("resume_score")       // 0-100 quality score
  resumeSuggestions String?  @map("resume_suggestions")  // JSON analysis from resume_ai
  // SHA-256 of the resume text the stored analysis was computed from. The worker
  // re-analyzes ONLY when this changes. It used to run resume_ai.analyze() on every
  // single sweep — an LLM call, every day, to re-score a resume that hadn't changed
  // since yesterday.
  resumeHash        String?  @map("resume_hash")

  // beta: one-tap "are these matches good?" survey (1-5). null = not yet asked
  matchQualityRating Int?     @map("match_quality_rating")
  // beta: surfaced to user when resume parsing produced no skills (manual fallback)
  resumeParseFailed  Boolean  @default(false) @map("resume_parse_failed")

  // explicit consent timestamp for auto-apply (audit trail; null = never consented)
  autoApplyConsentAt DateTime? @map("auto_apply_consent_at")

  // Where the daily report is delivered: "email" (default) | "slack". Picked in
  // onboarding, changeable any time from dashboard settings. Before this column
  // existed the onboarding choice was local React state that was never persisted,
  // and the worker sent to Slack unconditionally — so a user who chose Email got
  // nothing, and had no way to change their mind.
  reportChannel String @default("email") @map("report_channel")

  planJson   String?  @map("plan_json")   // agent-generated plan
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model Job {
  id         String   @id @default(cuid())
  source     String   @default("internshala")
  externalId String   @map("external_id")
  title      String
  company    String
  location   String?
  stipend    String?
  duration   String?
  skills     String   @default("[]") // JSON array
  url        String
  scrapedAt  DateTime @default(now()) @map("scraped_at")

  applications Application[]

  @@unique([source, externalId])
  @@map("jobs")
}

model Application {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId      String?  @map("job_id")
  job        Job?     @relation(fields: [jobId], references: [id])

  jobTitle   String   @map("job_title")
  company    String
  url        String?
  matchScore Int      @default(0) @map("match_score")
  // lifecycle: matched | approved | submitting | applied | skipped | failed | needs_review
  status     ApplyStatus @default(matched)
  reason     String?  // why matched / why skipped / failure detail
  // enumerated machine reason on failure — see FailureReason
  failureReason  FailureReason? @map("failure_reason")
  screenshotPath String? @map("screenshot_path")  // proof image of the submit attempt
  // The platform's screening questions and the answers submitted under the user's
  // name: JSON [{q, a, source}], where source is "profile" (a stored fact, e.g. their
  // real CGPA), "ai" (a model phrasing something their resume supports), or
  // "fallback". Recorded because an application the user cannot read back is one they
  // cannot walk into an interview and defend. See agent/questions.py.
  answersJson    String? @map("answers_json")
  // JSON array: what this role asked for that the candidate does not show. The
  // actionable half of a match score — "you scored 72" tells someone nothing they
  // can act on; "this role wants Docker and you don't show it" tells them what to
  // learn, and what they will be asked about if they get the call.
  missingSkills  String? @map("missing_skills")
  // immutable snapshot of the exact resume sent for this application
  resumeVersionId String?        @map("resume_version_id")
  resumeVersion   ResumeVersion? @relation(fields: [resumeVersionId], references: [id])
  // When this match is due to be surfaced to the user for a one-tap send.
  //
  // A single discovery sweep finds ~a month of work (plan cap x 30). Dumping all
  // of it on the dashboard at once would (a) hand the user a free job board they
  // could go apply to themselves, and (b) tempt a same-day mass-apply, which is
  // the single loudest bot signal there is. So matches are filed HIDDEN with a
  // date, and only the ones due today are ever returned to the client — see
  // src/app/api/applications/route.ts, which is the enforcement point.
  //
  // null = due immediately (legacy rows, and anything the user approved by hand).
  scheduledFor DateTime? @map("scheduled_for")
  // Set only after Grindly successfully delivers the final application link.
  notifiedAt  DateTime? @map("notified_at")
  appliedAt  DateTime? @map("applied_at")
  // user-reported outcome — the single most important beta signal (interview rate)
  // null (unset) until the user reports one
  outcome    Outcome?  @map("outcome")
  outcomeAt  DateTime? @map("outcome_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, status])
  @@index([status])
  @@index([jobId])
  @@index([resumeVersionId])
  @@index([createdAt])
  // The hot query: "what is due for this user right now" (status + scheduledFor).
  @@index([userId, status, scheduledFor])
  @@map("applications")
}

// Immutable record of the exact resume version sent for an application.
// Answers "which resume did the recruiter see?" — never mutated after create.
model ResumeVersion {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String   // human label e.g. "Frontend Dev @ Razorpay"
  jobTitle      String?  @map("job_title")
  company       String?
  text          String   // exact tailored resume text sent
  filePath      String?  @map("file_path")      // path to the exact PDF sent
  skillsClaimed String   @default("[]") @map("skills_claimed") // JSON: skills surfaced for this role
  baseSkills    String   @default("[]") @map("base_skills")    // JSON: master skills at time (truthfulness ref)
  // false = the master resume went out untouched. The agent only rewrites when
  // the master genuinely under-sells the candidate for this role (fitScore below
  // GRINDLY_TAILOR_THRESHOLD); a resume that already fits is left alone, because
  // every edit is a chance to break a layout the college mandated.
  tailored      Boolean  @default(false)
  // 0-100: how well the MASTER resume covered this job before any edit. This is
  // the number that decided whether to tailor — kept so the choice is auditable.
  fitScore      Int?     @map("fit_score")
  createdAt     DateTime @default(now()) @map("created_at")

  applications  Application[]

  @@index([userId])
  @@map("resume_versions")
}

// Append-only audit trail — reconstruct what the agent/auth did, for disputes.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // login | otp_issued | otp_throttled | apply | apply_failed | firewall_block | session_expired | consent
  target    String?  // job url / platform / phone-mask / etc
  detail    String?  // freeform or JSON
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

// DB-backed run queue — gives retries, per-user locking, and idempotent resume
// without needing Redis in the prototype. A worker (`worker.py --drain`) claims
// queued rows transactionally. Swap for BullMQ/Celery later behind the same shape.
model AgentRun {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Loose strings, not Postgres enums — same reasoning as UserIntegration.status
  // above: "connect_internshala" (credential-login relay job) was never added
  // to the old RunMode enum. mock is the safe default (every real call site
  // passes mode explicitly; this only matters if one ever doesn't).
  mode        String    @default("mock") // mock | live | analyze | connect_internshala
  status      String    @default("queued") // queued | running | done | failed | cancelled
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  // Non-null only while queued/running. The unique key is userId:mode, making
  // concurrent enqueue requests idempotent without dropping a different mode.
  activeKey   String?   @unique @map("active_key")
  // Human-paced runs yield the worker until this time instead of sleeping
  // inside a scarce browser process for 5-15 minutes.
  availableAt DateTime? @map("available_at")
  lockedBy    String?   @map("locked_by") // worker id holding the row
  lockedAt    DateTime? @map("locked_at")
  error       String?
  result      String?   // JSON {applied,matched,failed}
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([userId])
  @@map("agent_runs")
}

// Encrypted-at-rest platform credentials. Plaintext NEVER stored — ciphertext is
// AES-256-GCM (see src/lib/crypto.ts / agent/secret_box.py). Prefer storing
// session cookies over passwords; both go here encrypted.
model PlatformCredential {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String
  ciphertext String   // base64(nonce).base64(ciphertext+tag)
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, platform])
  @@map("platform_credentials")
}

// Tiered notification log with delivery tracking + channel fallback.
model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier      String   @default("digest") // urgent | digest
  channel   String   // inapp | slack | email | console
  title     String
  body      String
  delivered Boolean  @default(false)
  // In-app read state. null = unread; drives the dashboard bell's unread badge.
  // Only the "inapp" channel rows are ever surfaced to the user / marked read.
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Report {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String   // YYYY-MM-DD
  matchedCount Int      @default(0) @map("matched_count")
  appliedCount Int      @default(0) @map("applied_count")
  failedCount  Int      @default(0) @map("failed_count")
  summary      String   @default("")
  delivered    Boolean  @default(false) // sent to slack?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("reports")
}

model OtpToken {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@map("otp_tokens")
}

// DB-backed OTP brute-force counter. Replaces in-process Map in otp.ts.
// Survives multi-instance / serverless restarts.
model OtpAttempt {
  id         String   @id @default(cuid())
  phone      String   @unique
  attempts   Int      @default(0)
  windowEnd  DateTime @map("window_end")
  lockedUntil DateTime? @map("locked_until")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([phone])
  @@map("otp_attempts")
}

// DB-backed password reset tokens. 15-minute TTL, single-use.
// Replaces the in-process Map in passwordReset.ts.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash") // SHA-256 of the raw token
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// DB-backed rate-limit counters. Replaces in-process Map in rateLimit.ts.
// key = "forgot:<ip>" | "otp:<phone>" | etc.
model RateLimitEntry {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  windowEnd DateTime @map("window_end")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@map("rate_limit_entries")
}

// Written by scripts/backup-drill.sh (raw SQL, not Prisma) — declared here
// purely so `prisma db push` knows this table is intentional and doesn't
// propose dropping it as "undeclared." @db.Timestamptz matches that
// script's TIMESTAMPTZ columns exactly (Prisma's DateTime otherwise
// defaults to timestamp(3) with no time zone — a different underlying
// Postgres type, which would make db push want to drop+recreate anyway).
model BackupHealth {
  id            String    @id @default("singleton")
  lastDumpAt    DateTime? @map("last_dump_at") @db.Timestamptz
  lastRestoreAt DateTime? @map("last_restore_at") @db.Timestamptz
  lastRestoreOk Boolean   @default(false) @map("last_restore_ok")
  lastRowCount  Int?      @map("last_row_count")
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@map("backup_health")
}

// Pre-approved emails for the gated beta. An admin can allow an email BEFORE the
// person has signed up; the Google sign-in callback consults this on account
// creation and auto-approves a match. Separate from User so a grant can exist
// with no account yet.
model AccessAllowlist {
  id        String   @id @default(cuid())
  email     String   @unique
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("access_allowlist")
}

// Anonymous first-party visit log powering the owner analytics dashboard.
// visitorId is a random first-party cookie value, never an account id — no PII.
model PageView {
  id        String   @id @default(cuid())
  visitorId String   @map("visitor_id")
  path      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([visitorId])
  @@map("page_views")
}
